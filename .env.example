# Ask the Almanac (optional). Copy to .env.local for `npm run dev`; set the same
# names in Vercel's environment variables for deployments. Without them,
# /api/ask answers 503 not_configured and the rest of the app works as usual.
#
# Any OpenAI-compatible Chat Completions endpoint with tool calling works.
# Never prefix these with VITE_: Vite would inline them into the client bundle.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=
AI_API_KEY=

# Optional fallback, tried when the primary is rate-limited, down, or rejects
# the request. Example: Google Gemini's OpenAI-compatible endpoint.
AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
