{
  "name": "astromoon-calendar",
  "version": "1.0.0",
  "description": "Moon phase and zodiac calendar computed in the browser, with ICS, live webcal feed, and PDF export.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Brody Smith",
    "url": "https://smiths-forge.ca/"
  },
  "homepage": "https://astromoon.ca/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bsmithforge/AstroMoon-Calendar.git"
  },
  "bugs": {
    "url": "https://github.com/bsmithforge/AstroMoon-Calendar/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build && npm run build:api",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf dist server/dist"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
