    { "query": "forgive someone and move on", "expect": ["Third Quarter", "Scorpio", "Waning Gibbous"] },
    { "query": "plan a hiking trip", "expect": ["Sagittarius"] },
    { "query": "set goals for my career", "expect": ["Capricorn", "New Moon"] },
